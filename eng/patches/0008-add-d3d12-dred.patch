--- /dev/null
+++ b/src/dred.rs
@@ -0,0 +1,304 @@
+//! Direct3D 12 Device Removed Extended Data (DRED). When it is on, Direct3D records how far the GPU
+//! got through each command list ("breadcrumbs", with the PIX event and marker names around them)
+//! and the address of a GPU page fault. After a device removal, [`report`] turns that into text for
+//! the device-lost message, which says what the GPU was doing when it hung or faulted.
+//!
+//! Turned on by `WGPUInstanceFlag_D3D12DRED`. It applies to the whole process and costs a little
+//! GPU time, so it is meant for test builds.
+
+use std::collections::HashMap;
+use std::fmt::Write as _;
+use std::sync::atomic::{AtomicBool, Ordering};
+
+use windows::core::{s, Interface, GUID, HRESULT, PCWSTR};
+use windows::Win32::Foundation::E_NOINTERFACE;
+use windows::Win32::Graphics::Direct3D12::*;
+use windows::Win32::System::LibraryLoader::{GetProcAddress, LoadLibraryA};
+
+static ENABLED: AtomicBool = AtomicBool::new(false);
+
+/// Turns DRED on for every Direct3D 12 device created after this in the process.
+pub(crate) fn enable() {
+    if ENABLED.load(Ordering::Acquire) {
+        return;
+    }
+    match unsafe { try_enable() } {
+        Ok(()) => ENABLED.store(true, Ordering::Release),
+        Err(error) => log::warn!("Direct3D 12 DRED is not available: {error}"),
+    }
+}
+
+unsafe fn try_enable() -> windows::core::Result<()> {
+    type GetDebugInterface =
+        unsafe extern "system" fn(*const GUID, *mut *mut core::ffi::c_void) -> HRESULT;
+
+    // d3d12.dll is loaded when needed, as wgpu-hal does, instead of being linked.
+    let module = unsafe { LoadLibraryA(s!("d3d12.dll")) }?;
+    let proc = unsafe { GetProcAddress(module, s!("D3D12GetDebugInterface")) }
+        .ok_or(windows::core::Error::from(E_NOINTERFACE))?;
+    let get_debug_interface: GetDebugInterface = unsafe { core::mem::transmute(proc) };
+
+    let mut settings: Option<ID3D12DeviceRemovedExtendedDataSettings> = None;
+    unsafe {
+        get_debug_interface(
+            &ID3D12DeviceRemovedExtendedDataSettings::IID,
+            (&mut settings as *mut Option<_>).cast(),
+        )
+    }
+    .ok()?;
+    let settings = settings.ok_or(windows::core::Error::from(E_NOINTERFACE))?;
+    unsafe {
+        settings.SetAutoBreadcrumbsEnablement(D3D12_DRED_ENABLEMENT_FORCED_ON);
+        settings.SetPageFaultEnablement(D3D12_DRED_ENABLEMENT_FORCED_ON);
+        if let Ok(settings) = settings.cast::<ID3D12DeviceRemovedExtendedDataSettings1>() {
+            settings.SetBreadcrumbContextEnablement(D3D12_DRED_ENABLEMENT_FORCED_ON);
+        }
+    }
+    Ok(())
+}
+
+/// What DRED recorded before `device` was removed, or `None` if DRED is off.
+pub(crate) fn report(device: &ID3D12Device) -> Option<String> {
+    if !ENABLED.load(Ordering::Acquire) {
+        return None;
+    }
+    let dred = device.cast::<ID3D12DeviceRemovedExtendedData1>().ok()?;
+    let mut out = String::from("DRED:");
+
+    match unsafe { dred.GetAutoBreadcrumbsOutput1() } {
+        Ok(breadcrumbs) => {
+            let (mut recorded, mut unfinished) = (0, 0);
+            let mut node = breadcrumbs.pHeadAutoBreadcrumbNode;
+            while let Some(list) = unsafe { node.as_ref() } {
+                recorded += 1;
+                if describe_unfinished(list, &mut out) {
+                    unfinished += 1;
+                }
+                node = list.pNext;
+            }
+            if unfinished == 0 {
+                let _ = write!(
+                    out,
+                    " the {recorded} command lists it recorded had all finished."
+                );
+            }
+        }
+        Err(error) => {
+            let _ = write!(out, " no breadcrumbs ({error}).");
+        }
+    }
+
+    if let Ok(fault) = unsafe { dred.GetPageFaultAllocationOutput1() } {
+        if fault.PageFaultVA != 0 {
+            let _ = write!(out, " GPU page fault at 0x{:X}", fault.PageFaultVA);
+            let existing = allocation_names(fault.pHeadExistingAllocationNode);
+            let freed = allocation_names(fault.pHeadRecentFreedAllocationNode);
+            if !existing.is_empty() {
+                let _ = write!(out, ", in {}", existing.join(", "));
+            }
+            if !freed.is_empty() {
+                let _ = write!(out, ", in recently freed {}", freed.join(", "));
+            }
+            out.push('.');
+        }
+    }
+    Some(out)
+}
+
+/// Appends a description of `list` if the GPU didn't finish it, and returns whether it didn't.
+fn describe_unfinished(list: &D3D12_AUTO_BREADCRUMB_NODE1, out: &mut String) -> bool {
+    let count = list.BreadcrumbCount as usize;
+    let done = unsafe { list.pLastBreadcrumbValue.as_ref() }.map_or(0, |&value| value as usize);
+    if done >= count || list.pCommandHistory.is_null() {
+        return false;
+    }
+    let history = unsafe { core::slice::from_raw_parts(list.pCommandHistory, count) };
+
+    let mut names = HashMap::new();
+    if !list.pBreadcrumbContexts.is_null() {
+        let contexts = unsafe {
+            core::slice::from_raw_parts(
+                list.pBreadcrumbContexts,
+                list.BreadcrumbContextsCount as usize,
+            )
+        };
+        for context in contexts {
+            names.insert(
+                context.BreadcrumbIndex as usize,
+                wide(context.pContextString),
+            );
+        }
+    }
+
+    // The PIX events (debug groups, pass labels) that were open at the operation that didn't finish.
+    let mut events = Vec::new();
+    for (index, op) in history.iter().enumerate().take(done + 1) {
+        if *op == D3D12_AUTO_BREADCRUMB_OP_BEGINEVENT {
+            events.push(names.get(&index).cloned().flatten().unwrap_or_default());
+        } else if *op == D3D12_AUTO_BREADCRUMB_OP_ENDEVENT {
+            events.pop();
+        }
+    }
+
+    let _ = write!(
+        out,
+        " command list {} on queue {} stopped after {done} of {count} operations, at {}",
+        quoted(list.pCommandListDebugNameW),
+        quoted(list.pCommandQueueDebugNameW),
+        op_name(history[done]),
+    );
+    let events: Vec<_> = events.into_iter().filter(|name| !name.is_empty()).collect();
+    if !events.is_empty() {
+        let _ = write!(out, " inside \"{}\"", events.join("\" > \""));
+    }
+    out.push('.');
+    true
+}
+
+fn allocation_names(mut node: *const D3D12_DRED_ALLOCATION_NODE1) -> Vec<String> {
+    let mut names = Vec::new();
+    while let Some(allocation) = unsafe { node.as_ref() } {
+        if let Some(name) = wide(allocation.ObjectNameW) {
+            names.push(format!("\"{name}\""));
+        }
+        node = allocation.pNext;
+    }
+    names
+}
+
+fn wide(text: PCWSTR) -> Option<String> {
+    if text.is_null() {
+        return None;
+    }
+    unsafe { text.to_string() }
+        .ok()
+        .filter(|text| !text.is_empty())
+}
+
+fn quoted(text: PCWSTR) -> String {
+    wide(text).map_or_else(|| "(unnamed)".to_string(), |text| format!("\"{text}\""))
+}
+
+fn op_name(op: D3D12_AUTO_BREADCRUMB_OP) -> String {
+    let name = match op {
+        D3D12_AUTO_BREADCRUMB_OP_SETMARKER => "SetMarker",
+        D3D12_AUTO_BREADCRUMB_OP_BEGINEVENT => "BeginEvent",
+        D3D12_AUTO_BREADCRUMB_OP_ENDEVENT => "EndEvent",
+        D3D12_AUTO_BREADCRUMB_OP_DRAWINSTANCED => "DrawInstanced",
+        D3D12_AUTO_BREADCRUMB_OP_DRAWINDEXEDINSTANCED => "DrawIndexedInstanced",
+        D3D12_AUTO_BREADCRUMB_OP_EXECUTEINDIRECT => "ExecuteIndirect",
+        D3D12_AUTO_BREADCRUMB_OP_DISPATCH => "Dispatch",
+        D3D12_AUTO_BREADCRUMB_OP_COPYBUFFERREGION => "CopyBufferRegion",
+        D3D12_AUTO_BREADCRUMB_OP_COPYTEXTUREREGION => "CopyTextureRegion",
+        D3D12_AUTO_BREADCRUMB_OP_COPYRESOURCE => "CopyResource",
+        D3D12_AUTO_BREADCRUMB_OP_COPYTILES => "CopyTiles",
+        D3D12_AUTO_BREADCRUMB_OP_RESOLVESUBRESOURCE => "ResolveSubresource",
+        D3D12_AUTO_BREADCRUMB_OP_CLEARRENDERTARGETVIEW => "ClearRenderTargetView",
+        D3D12_AUTO_BREADCRUMB_OP_CLEARUNORDEREDACCESSVIEW => "ClearUnorderedAccessView",
+        D3D12_AUTO_BREADCRUMB_OP_CLEARDEPTHSTENCILVIEW => "ClearDepthStencilView",
+        D3D12_AUTO_BREADCRUMB_OP_RESOURCEBARRIER => "ResourceBarrier",
+        D3D12_AUTO_BREADCRUMB_OP_EXECUTEBUNDLE => "ExecuteBundle",
+        D3D12_AUTO_BREADCRUMB_OP_PRESENT => "Present",
+        D3D12_AUTO_BREADCRUMB_OP_RESOLVEQUERYDATA => "ResolveQueryData",
+        D3D12_AUTO_BREADCRUMB_OP_BEGINSUBMISSION => "BeginSubmission",
+        D3D12_AUTO_BREADCRUMB_OP_ENDSUBMISSION => "EndSubmission",
+        D3D12_AUTO_BREADCRUMB_OP_WRITEBUFFERIMMEDIATE => "WriteBufferImmediate",
+        D3D12_AUTO_BREADCRUMB_OP_BUILDRAYTRACINGACCELERATIONSTRUCTURE => {
+            "BuildRaytracingAccelerationStructure"
+        }
+        D3D12_AUTO_BREADCRUMB_OP_DISPATCHRAYS => "DispatchRays",
+        D3D12_AUTO_BREADCRUMB_OP_SETPIPELINESTATE1 => "SetPipelineState1",
+        D3D12_AUTO_BREADCRUMB_OP_DISPATCHMESH => "DispatchMesh",
+        D3D12_AUTO_BREADCRUMB_OP_BARRIER => "Barrier",
+        D3D12_AUTO_BREADCRUMB_OP_BEGIN_COMMAND_LIST => "BeginCommandList",
+        _ => return format!("operation {}", op.0),
+    };
+    name.to_string()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn wide_str(text: &str) -> Vec<u16> {
+        text.encode_utf16().chain([0]).collect()
+    }
+
+    #[test]
+    fn describes_the_operation_a_command_list_stopped_at() {
+        let list_name = wide_str("frame encoder");
+        let outer = wide_str("shadow pass");
+        let inner = wide_str("cascade 2");
+        let history = [
+            D3D12_AUTO_BREADCRUMB_OP_BEGIN_COMMAND_LIST,
+            D3D12_AUTO_BREADCRUMB_OP_BEGINEVENT,
+            D3D12_AUTO_BREADCRUMB_OP_BEGINEVENT,
+            D3D12_AUTO_BREADCRUMB_OP_DRAWINSTANCED,
+            D3D12_AUTO_BREADCRUMB_OP_DRAWINDEXEDINSTANCED,
+            D3D12_AUTO_BREADCRUMB_OP_ENDEVENT,
+            D3D12_AUTO_BREADCRUMB_OP_ENDEVENT,
+        ];
+        let mut contexts = [
+            D3D12_DRED_BREADCRUMB_CONTEXT {
+                BreadcrumbIndex: 1,
+                pContextString: PCWSTR(outer.as_ptr()),
+            },
+            D3D12_DRED_BREADCRUMB_CONTEXT {
+                BreadcrumbIndex: 2,
+                pContextString: PCWSTR(inner.as_ptr()),
+            },
+        ];
+        let completed = 4u32;
+        let list = D3D12_AUTO_BREADCRUMB_NODE1 {
+            pCommandListDebugNameW: PCWSTR(list_name.as_ptr()),
+            BreadcrumbCount: history.len() as u32,
+            pLastBreadcrumbValue: &completed,
+            pCommandHistory: history.as_ptr(),
+            BreadcrumbContextsCount: contexts.len() as u32,
+            pBreadcrumbContexts: contexts.as_mut_ptr(),
+            ..Default::default()
+        };
+
+        let mut out = String::new();
+        assert!(describe_unfinished(&list, &mut out));
+        assert_eq!(
+            out,
+            " command list \"frame encoder\" on queue (unnamed) stopped after 4 of 7 operations, \
+             at DrawIndexedInstanced inside \"shadow pass\" > \"cascade 2\"."
+        );
+    }
+
+    #[test]
+    fn skips_finished_command_lists() {
+        let history = [D3D12_AUTO_BREADCRUMB_OP_DISPATCH];
+        let completed = 1u32;
+        let list = D3D12_AUTO_BREADCRUMB_NODE1 {
+            BreadcrumbCount: 1,
+            pLastBreadcrumbValue: &completed,
+            pCommandHistory: history.as_ptr(),
+            ..Default::default()
+        };
+        let mut out = String::new();
+        assert!(!describe_unfinished(&list, &mut out));
+        assert!(out.is_empty());
+
+        let no_history = D3D12_AUTO_BREADCRUMB_NODE1 {
+            BreadcrumbCount: 3,
+            ..Default::default()
+        };
+        assert!(!describe_unfinished(&no_history, &mut out));
+    }
+
+    #[test]
+    fn names_page_fault_allocations() {
+        let name = wide_str("vertex buffer");
+        let second = D3D12_DRED_ALLOCATION_NODE1::default();
+        let first = D3D12_DRED_ALLOCATION_NODE1 {
+            ObjectNameW: PCWSTR(name.as_ptr()),
+            pNext: &second,
+            ..Default::default()
+        };
+        assert_eq!(allocation_names(&first), ["\"vertex buffer\""]);
+        assert_eq!(op_name(D3D12_AUTO_BREADCRUMB_OP(999)), "operation 999");
+    }
+}
