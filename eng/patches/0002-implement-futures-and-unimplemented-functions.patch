index bfb9335..62e56ec 100644
--- a/build.rs
+++ b/build.rs
@@ -102,4 +102,58 @@ fn main() {
     bindings
         .write_to_file(out_path.join("bindings.rs"))
         .expect("Couldn't write bindings!");
+
+    write_proc_table(&out_path.join("proc_table.rs"));
+}
+
+/// Generates the name -> function table behind `wgpuGetProcAddress` from every function the
+/// two headers declare, so it can never drift from them.
+fn write_proc_table(path: &std::path::Path) {
+    let mut names = Vec::new();
+    for header in ["ffi/webgpu-headers/webgpu.h", "ffi/wgpu.h"] {
+        let text = std::fs::read_to_string(header).expect("read header");
+        // Join code lines (dropping comments and preprocessor lines) into `;`-terminated
+        // statements, so declarations that span several lines are seen whole.
+        let mut code = String::new();
+        for line in text.lines() {
+            let line = line.trim();
+            if line.starts_with('*') || line.starts_with('/') || line.starts_with('#') {
+                continue;
+            }
+            code.push_str(line);
+            code.push(' ');
+        }
+        for statement in code.split([';', '{', '}']) {
+            let statement = statement.trim();
+            if statement.starts_with("typedef") {
+                continue;
+            }
+            let Some(open) = statement.find('(') else {
+                continue;
+            };
+            let head = &statement[..open];
+            let name = head
+                .rsplit(|c: char| !(c.is_ascii_alphanumeric() || c == '_'))
+                .next()
+                .unwrap_or("");
+            if name.starts_with("wgpu")
+                && name[4..].starts_with(|c: char| c.is_ascii_uppercase())
+                && !names.iter().any(|n| n == name)
+            {
+                names.push(name.to_string());
+            }
+        }
+    }
+    names.sort();
+    let mut out = String::from(
+        "// Generated by build.rs from webgpu.h and wgpu.h.\n\
+         pub(crate) fn lookup(name: &[u8]) -> Option<*const ()> {\n    match name {\n",
+    );
+    for name in &names {
+        out.push_str(&format!(
+            "        b\"{name}\" => Some({name} as *const ()),\n"
+        ));
+    }
+    out.push_str("        _ => None,\n    }\n}\n");
+    std::fs::write(path, out).expect("write proc table");
 }
diff --git a/src/futures.rs b/src/futures.rs
new file mode 100644
index 0000000..fb2343a
--- /dev/null
+++ b/src/futures.rs
@@ -0,0 +1,407 @@
+//! `WGPUFuture` support: callback modes, `wgpuInstanceWaitAny` and `wgpuInstanceProcessEvents`.
+//!
+//! Every asynchronous entry point registers a future here and returns its id. When the operation
+//! completes, it hands over a closure that fires the user's callback. When that closure runs
+//! depends on the callback mode:
+//!
+//! - `WaitAnyOnly`: inside `wgpuInstanceWaitAny` on that future.
+//! - `AllowProcessEvents`: inside `wgpuInstanceWaitAny` or `wgpuInstanceProcessEvents`.
+//! - `AllowSpontaneous`: as soon as the operation completes, possibly on another thread.
+//!
+//! A zero (unset) mode behaves like `AllowSpontaneous`, which is how wgpu-native fired every
+//! callback before futures were implemented.
+//!
+//! Callbacks never run while the registry lock is held, so they may re-enter the API.
+//! When the last reference to an instance is released, its pending callbacks fire with
+//! `CallbackCancelled`.
+
+use std::{
+    collections::HashMap,
+    sync::{
+        atomic::{AtomicU64, Ordering},
+        Arc, LazyLock,
+    },
+    time::{Duration, Instant},
+};
+
+use parking_lot::{Condvar, Mutex};
+use wgc::id;
+
+use crate::{native, Context};
+
+/// The most futures a timed `wgpuInstanceWaitAny` accepts (reported as `timedWaitAnyMaxCount`).
+pub const TIMED_WAIT_ANY_MAX_COUNT: usize = 64;
+
+/// Fires a completed operation's callback. The argument is `true` when the callback is being
+/// cancelled because the instance was released.
+pub(crate) type Fire = Box<dyn FnOnce(bool) + Send>;
+
+/// Fires a still-pending operation's callback with a `CallbackCancelled` status.
+pub(crate) type Cancel = Box<dyn FnOnce() + Send>;
+
+#[derive(Clone, Copy, PartialEq, Eq, Debug)]
+pub(crate) enum Mode {
+    WaitAnyOnly,
+    AllowProcessEvents,
+    AllowSpontaneous,
+}
+
+impl Mode {
+    pub(crate) fn from_native(mode: native::WGPUCallbackMode) -> Mode {
+        match mode {
+            native::WGPUCallbackMode_WaitAnyOnly => Mode::WaitAnyOnly,
+            native::WGPUCallbackMode_AllowProcessEvents => Mode::AllowProcessEvents,
+            _ => Mode::AllowSpontaneous,
+        }
+    }
+}
+
+enum State {
+    /// Still running. Holds what to do if the instance goes away first.
+    Pending(Option<Cancel>),
+    /// Completed; the callback has not fired yet.
+    Ready(Fire),
+    /// The instance was released while the operation was pending. Its callback already fired
+    /// with `CallbackCancelled`; the eventual result is dropped.
+    Cancelled,
+}
+
+struct Entry {
+    owner: Arc<Context>,
+    mode: Mode,
+    state: State,
+    /// The device whose queue must make progress for this future to complete, if any.
+    device: Option<id::DeviceId>,
+}
+
+#[derive(Default)]
+struct Registry {
+    entries: HashMap<u64, Entry>,
+}
+
+static NEXT_ID: AtomicU64 = AtomicU64::new(1);
+static REGISTRY: LazyLock<Mutex<Registry>> = LazyLock::new(Default::default);
+static COMPLETED: Condvar = Condvar::new();
+
+/// The producing side of a future. Call [`Completer::complete`] exactly once.
+/// Dropping it without completing cancels the future.
+pub(crate) struct Completer {
+    id: u64,
+}
+
+impl Completer {
+    pub(crate) fn future(&self) -> native::WGPUFuture {
+        native::WGPUFuture { id: self.id }
+    }
+
+    pub(crate) fn complete(mut self, fire: Fire) {
+        let id = mem_take_id(&mut self.id);
+        let mut registry = REGISTRY.lock();
+        let Some(entry) = registry.entries.get_mut(&id) else {
+            return;
+        };
+        match (&entry.state, entry.mode) {
+            (State::Cancelled, _) => {
+                registry.entries.remove(&id);
+                drop(registry);
+                drop(fire);
+            }
+            (_, Mode::AllowSpontaneous) => {
+                registry.entries.remove(&id);
+                drop(registry);
+                fire(false);
+            }
+            _ => {
+                entry.state = State::Ready(fire);
+                drop(registry);
+                COMPLETED.notify_all();
+            }
+        }
+    }
+}
+
+fn mem_take_id(id: &mut u64) -> u64 {
+    std::mem::replace(id, 0)
+}
+
+impl Drop for Completer {
+    fn drop(&mut self) {
+        if self.id == 0 {
+            return;
+        }
+        // Never completed (e.g. wgpu-core dropped the closure): cancel it.
+        let cancel = {
+            let mut registry = REGISTRY.lock();
+            match registry.entries.remove(&self.id) {
+                Some(Entry {
+                    state: State::Pending(cancel),
+                    ..
+                }) => cancel,
+                _ => None,
+            }
+        };
+        COMPLETED.notify_all();
+        if let Some(cancel) = cancel {
+            cancel();
+        }
+    }
+}
+
+/// Registers a new future owned by the instance behind `owner`.
+pub(crate) fn create(
+    owner: &Arc<Context>,
+    mode: native::WGPUCallbackMode,
+    device: Option<id::DeviceId>,
+    cancel: Cancel,
+) -> Completer {
+    let id = NEXT_ID.fetch_add(1, Ordering::Relaxed);
+    REGISTRY.lock().entries.insert(
+        id,
+        Entry {
+            owner: owner.clone(),
+            mode: Mode::from_native(mode),
+            state: State::Pending(Some(cancel)),
+            device,
+        },
+    );
+    Completer { id }
+}
+
+/// Fires the callbacks of every completed `AllowProcessEvents` future of this instance.
+pub(crate) fn process_events(owner: &Arc<Context>) {
+    let fires: Vec<Fire> = {
+        let mut registry = REGISTRY.lock();
+        let ids: Vec<u64> = registry
+            .entries
+            .iter()
+            .filter(|(_, e)| {
+                Arc::ptr_eq(&e.owner, owner)
+                    && e.mode == Mode::AllowProcessEvents
+                    && matches!(e.state, State::Ready(_))
+            })
+            .map(|(id, _)| *id)
+            .collect();
+        let mut sorted = ids;
+        sorted.sort_unstable(); // fire in creation order
+        sorted
+            .into_iter()
+            .filter_map(|id| match registry.entries.remove(&id) {
+                Some(Entry {
+                    state: State::Ready(fire),
+                    ..
+                }) => Some(fire),
+                _ => None,
+            })
+            .collect()
+    };
+    for fire in fires {
+        fire(false);
+    }
+}
+
+/// Fires every outstanding callback of this instance with `CallbackCancelled`.
+pub(crate) fn cancel_all(owner: &Arc<Context>) {
+    let mut fires: Vec<Fire> = Vec::new();
+    let mut cancels: Vec<Cancel> = Vec::new();
+    {
+        let mut registry = REGISTRY.lock();
+        let mut ids: Vec<u64> = registry
+            .entries
+            .iter()
+            .filter(|(_, e)| Arc::ptr_eq(&e.owner, owner))
+            .map(|(id, _)| *id)
+            .collect();
+        ids.sort_unstable();
+        for id in ids {
+            let entry = registry.entries.get_mut(&id).unwrap();
+            match std::mem::replace(&mut entry.state, State::Cancelled) {
+                State::Ready(fire) => {
+                    registry.entries.remove(&id);
+                    fires.push(fire);
+                }
+                State::Pending(cancel) => cancels.extend(cancel),
+                State::Cancelled => (),
+            }
+        }
+    }
+    for fire in fires {
+        fire(true);
+    }
+    for cancel in cancels {
+        cancel();
+    }
+}
+
+enum Scan {
+    Error(&'static str),
+    Completed(Vec<Fire>),
+    Pending(Vec<id::DeviceId>),
+}
+
+fn scan(owner: &Arc<Context>, futures: &mut [native::WGPUFutureWaitInfo]) -> Scan {
+    let mut registry = REGISTRY.lock();
+    let next_id = NEXT_ID.load(Ordering::Relaxed);
+    let mut fires = Vec::new();
+    let mut devices = Vec::new();
+    let mut any_completed = false;
+    for info in futures.iter_mut() {
+        let id = info.future.id;
+        if id == 0 || id >= next_id {
+            return Scan::Error("invalid WGPUFuture");
+        }
+        match registry.entries.get(&id) {
+            // Futures are removed once their callback has fired.
+            None => {
+                info.completed = 1;
+                any_completed = true;
+            }
+            Some(entry) if !Arc::ptr_eq(&entry.owner, owner) => {
+                return Scan::Error("WGPUFuture belongs to a different instance");
+            }
+            Some(entry) => match entry.state {
+                State::Ready(_) => {
+                    let Some(Entry {
+                        state: State::Ready(fire),
+                        ..
+                    }) = registry.entries.remove(&id)
+                    else {
+                        unreachable!()
+                    };
+                    fires.push(fire);
+                    info.completed = 1;
+                    any_completed = true;
+                }
+                State::Cancelled => {
+                    info.completed = 1;
+                    any_completed = true;
+                }
+                State::Pending(_) => {
+                    info.completed = 0;
+                    if let Some(device) = entry.device {
+                        if !devices.contains(&device) {
+                            devices.push(device);
+                        }
+                    }
+                }
+            },
+        }
+    }
+    if any_completed {
+        Scan::Completed(fires)
+    } else {
+        Scan::Pending(devices)
+    }
+}
+
+pub(crate) fn wait_any(
+    owner: &Arc<Context>,
+    futures: &mut [native::WGPUFutureWaitInfo],
+    timeout_ns: u64,
+    timed_wait_max_count: usize,
+) -> native::WGPUWaitStatus {
+    if timeout_ns > 0 {
+        if timed_wait_max_count == 0 {
+            log::error!(
+                "wgpuInstanceWaitAny: timeoutNS > 0 requires WGPUInstanceFeatureName_TimedWaitAny"
+            );
+            return native::WGPUWaitStatus_Error;
+        }
+        if futures.len() > timed_wait_max_count {
+            log::error!(
+                "wgpuInstanceWaitAny: this instance's timed waits accept at most {timed_wait_max_count} futures"
+            );
+            return native::WGPUWaitStatus_Error;
+        }
+    }
+    if futures.is_empty() {
+        return native::WGPUWaitStatus_Success;
+    }
+
+    let deadline = Instant::now().checked_add(Duration::from_nanos(timeout_ns));
+    let mut first = true;
+    loop {
+        let devices = match scan(owner, futures) {
+            Scan::Error(message) => {
+                log::error!("wgpuInstanceWaitAny: {message}");
+                return native::WGPUWaitStatus_Error;
+            }
+            Scan::Completed(fires) => {
+                for fire in fires {
+                    fire(false);
+                }
+                return native::WGPUWaitStatus_Success;
+            }
+            Scan::Pending(devices) => devices,
+        };
+
+        // Make progress on the queues the pending futures depend on. Polling may complete
+        // futures (wgpu-core runs their closures), so scan again right after.
+        if first || timeout_ns == 0 {
+            first = false;
+            for &device in &devices {
+                let _ = owner.device_poll(device, wgt::PollType::Poll);
+            }
+            if timeout_ns == 0 {
+                return match scan(owner, futures) {
+                    Scan::Completed(fires) => {
+                        for fire in fires {
+                            fire(false);
+                        }
+                        native::WGPUWaitStatus_Success
+                    }
+                    Scan::Pending(_) => native::WGPUWaitStatus_TimedOut,
+                    Scan::Error(message) => {
+                        log::error!("wgpuInstanceWaitAny: {message}");
+                        native::WGPUWaitStatus_Error
+                    }
+                };
+            }
+            continue;
+        }
+
+        let remaining = match deadline {
+            Some(deadline) => match deadline.checked_duration_since(Instant::now()) {
+                Some(remaining) if !remaining.is_zero() => Some(remaining),
+                _ => return native::WGPUWaitStatus_TimedOut,
+            },
+            None => None, // effectively infinite
+        };
+
+        if let Some(&device) = devices.first() {
+            // Block on the GPU instead of spinning. If the queue is already idle, the future
+            // is waiting on something else (e.g. a map that needs another poll), so fall
+            // through to a short condvar wait.
+            let started = Instant::now();
+            let result = owner.device_poll(
+                device,
+                wgt::PollType::Wait {
+                    submission_index: None,
+                    timeout: remaining,
+                },
+            );
+            for &other in devices.iter().skip(1) {
+                let _ = owner.device_poll(other, wgt::PollType::Poll);
+            }
+            let made_progress = matches!(result, Ok(wgt::PollStatus::WaitSucceeded))
+                || started.elapsed() > Duration::from_millis(1);
+            if made_progress {
+                continue;
+            }
+        }
+
+        // Wait for another thread to complete one of the futures (or for the next poll slot).
+        let slice = Duration::from_millis(1);
+        let wait = remaining.map_or(slice, |r| r.min(slice));
+        let mut registry = REGISTRY.lock();
+        let _ = COMPLETED.wait_for(&mut registry, wait);
+    }
+}
+
+/// `Send` wrapper for raw handles captured by deferred callbacks.
+pub(crate) struct SendPtr<T>(pub *const T);
+unsafe impl<T> Send for SendPtr<T> {}
+impl<T> SendPtr<T> {
+    pub(crate) fn get(&self) -> *const T {
+        self.0
+    }
+}
