+/// The mapped range `[offset, offset + size)` of `buffer`, or `None` (with a logged reason).
+unsafe fn mapped_range(
+    buffer: native::WGPUBuffer,
+    offset: usize,
+    size: Option<u64>,
+    fn_ident: &str,
+) -> Option<*mut u8> {
+    let buffer = buffer.as_ref().expect("invalid buffer");
+    match buffer
+        .context
+        .buffer_get_mapped_range(buffer.id, offset as wgt::BufferAddress, size)
+    {
+        Ok((ptr, _)) => Some(ptr.as_ptr()),
+        Err(err) => {
+            log::error!("{fn_ident}: {}", format_error(&err));
+            None
+        }
+    }
 }
 
