+// The `Create*PipelineAsync` functions create the pipeline synchronously and hand the result,
+// or the first error creation reported, to the callback according to its callback mode.
+macro_rules! create_pipeline_async {
+    ($name:ident, $sync:ident, $descriptor:ty, $callback_info:ty, $pipeline:ty) => {
+        #[no_mangle]
+        pub unsafe extern "C" fn $name(
+            device: native::WGPUDevice,
+            descriptor: Option<&$descriptor>,
+            callback_info: $callback_info,
+        ) -> native::WGPUFuture {
+            let context = &device.as_ref().expect("invalid device").context;
+            let callback = callback_info.callback;
+            let cancel_userdata = new_userdata!(callback_info);
+            let completer = futures::create(
+                context,
+                callback_info.mode,
+                None,
+                Box::new(move || {
+                    if let Some(callback) = callback {
