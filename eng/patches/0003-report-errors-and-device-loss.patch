                 return;
             }
             crate::Error::OutOfMemory { .. } => (
@@ -761,13 +776,6 @@ fn format_error(err: &(impl error::Error + 'static)) -> String {
     format!("Validation Error\n\nCaused by:\n{}", output)
 }
 
-fn handle_error_fatal(
-    cause: impl error::Error + Send + Sync + 'static,
-    operation: &'static str,
-) -> ! {
-    panic!("Error in {operation}: {f}", f = format_error(&cause));
-}
-
 fn handle_error(
     sink_mutex: &Mutex<ErrorSinkRaw>,
     source: impl wgt::error::WebGpuError + Send + Sync + 'static,
@@ -1247,6 +1255,37 @@ pub unsafe extern "C" fn wgpuAdapterRequestDevice(
                     lost_future,
                 }
             });
+
+            // wgpu-core calls this when it loses the device itself: a removed or reset GPU, an
+            // unexpected backend error or running out of memory (Unknown), or the end of a
+            // `destroy` (Destroyed). It runs while wgpu-core holds its locks, so the callback
+            // is completed off this thread.
+            let lost_sink = Arc::downgrade(&device_impl.error_sink);
+            context.device_set_device_lost_closure(
+                device_id,
+                Box::new(move |reason, message| {
+                    let Some(sink) = lost_sink.upgrade() else {
+                        return;
+                    };
+                    let reason = match reason {
+                        wgt::DeviceLostReason::Destroyed => native::WGPUDeviceLostReason_Destroyed,
+                        wgt::DeviceLostReason::Unknown => native::WGPUDeviceLostReason_Unknown,
+                    };
+                    let message = if message.is_empty() {
+                        "The device was lost".to_string()
+                    } else {
+                        message
+                    };
+                    let lost = {
+                        let mut sink = sink.lock();
+                        let device = sink.device.as_ptr();
+                        sink.take_device_lost(device, reason, &message)
+                    };
+                    if let Some((completer, fire)) = lost {
+                        completer.complete_off_thread(fire);
+                    }
+                }),
+            );
             let device = SendPtr(Arc::into_raw(device_impl));
 
             request.complete(Box::new(move |cancelled| {
@@ -2767,9 +2806,9 @@ pub unsafe extern "C-unwind" fn wgpuDeviceCreateRenderBundleEncoder(
