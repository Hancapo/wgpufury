From b0ae2d771c900346a4c572c751a1108a4c03146c Mon Sep 17 00:00:00 2001
From: WGpuFury <wgpufury@users.noreply.github.com>
Date: Wed, 25 Nov 2026 16:01:43 -0300
Subject: [PATCH] Report errors instead of aborting, and fire the lost callback
 when wgpu loses the device

wgpu-native panicked (aborting the process) whenever wgpu-core returned an
error from surface creation, configuration, acquisition and unconfiguration,
polling, device release, and render bundle encoding. Those errors now go to
the device's error scopes / uncaptured-error callback, the call returns its
error value (NULL surface, Error texture status, WGPUNativePollStatus_Error),
or, where there is no device, they are logged.

wgpu-native also never registered wgpu-core's device-lost closure, so a device
that wgpu-core lost by itself (a removed or reset GPU, an unexpected backend
error) only reported it if a later call happened to fail. The closure now
completes the lost future. It runs under wgpu-core's locks, so spontaneous
callbacks are fired from a new thread.
---
 ffi/wgpu.h     |   5 ++
 src/futures.rs |  35 +++++++++++
 src/lib.rs     | 162 ++++++++++++++++++++++++++++++++++++++-----------
 3 files changed, 165 insertions(+), 37 deletions(-)

diff --git a/ffi/wgpu.h b/ffi/wgpu.h
index 851e227..7ea1321 100644
--- a/ffi/wgpu.h
+++ b/ffi/wgpu.h
@@ -1622,6 +1622,11 @@ typedef enum WGPUNativePollStatus
      * queue remain valid, and the caller may poll or wait again.
      */
     WGPUNativePollStatus_Timeout = 0x00000004,
+    /**
+     * The poll failed, e.g. because the device is lost. The error is also reported to the
+     * device (its error scopes or uncaptured-error callback, or its lost callback).
+     */
+    WGPUNativePollStatus_Error = 0x00000005,
     WGPUNativePollStatus_Force32 = 0x7FFFFFFF
 } WGPUNativePollStatus;
 
diff --git a/src/futures.rs b/src/futures.rs
index fb2343a..2d3aa32 100644
--- a/src/futures.rs
+++ b/src/futures.rs
@@ -120,6 +120,41 @@ impl Completer {
     }
 }
 
+impl Completer {
+    /// Like [`Completer::complete`], but the callback never runs on the calling thread: a
+    /// spontaneous callback runs on a new thread, the other modes only become ready. For
+    /// completions that happen inside wgpu-core or under one of our locks (the device-lost
+    /// closure runs while wgpu-core holds its own), where a callback calling back into wgpu
+    /// would deadlock.
+    pub(crate) fn complete_off_thread(mut self, fire: Fire) {
+        let id = mem_take_id(&mut self.id);
+        let mut registry = REGISTRY.lock();
+        let Some(entry) = registry.entries.get_mut(&id) else {
+            return;
+        };
+        match (&entry.state, entry.mode) {
+            (State::Cancelled, _) => {
+                registry.entries.remove(&id);
+                drop(registry);
+                drop(fire);
+            }
+            (_, Mode::AllowSpontaneous) => {
+                registry.entries.remove(&id);
+                drop(registry);
+                std::thread::Builder::new()
+                    .name("wgpu-native callback".into())
+                    .spawn(move || fire(false))
+                    .expect("spawn callback thread");
+            }
+            _ => {
+                entry.state = State::Ready(fire);
+                drop(registry);
+                COMPLETED.notify_all();
+            }
+        }
+    }
+}
+
 fn mem_take_id(id: &mut u64) -> u64 {
     std::mem::replace(id, 0)
 }
